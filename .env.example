# Copy this file to .env and replace the placeholder values.
# .env is not committed. The application reads these variables at startup
# and uses them instead of any secret that might otherwise be put in YAML.

# Required.
# The application inserts this value into the ODBC connection string as UID=.
# Replace the placeholder with the password for that login.
SQLSERVER_USER=sa

# Required.
# The application inserts this value into the ODBC connection string as PWD=.
# Replace the placeholder with the password for that login.
SQLSERVER_PASSWORD=ChangeMe_UseAStrongPassword1!
# Optional SQL Server overrides. Defaults live in config/settings.yaml.
# SQLSERVER_HOST=localhost
# SQLSERVER_PORT=1433
# SQLSERVER_DATABASE=StopWorkOrders
# SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# SQLSERVER_ENCRYPT=true
# SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# Required when smtp.enabled is true and smtp.username is set.
SMTP_PASSWORD=

# Optional SMTP overrides. Defaults live in config/settings.yaml.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=alerts@example.com
# SMTP_FROM=alerts@example.com
# Comma-separated recipients.
# SMTP_TO=compliance@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_ENABLED=true
